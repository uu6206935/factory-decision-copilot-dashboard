# Core paths
DATA_DIR=./sample_data
RUNTIME_DIR=./runtime
DATABASE_URL=sqlite:///./runtime/factory_copilot.db

# DeepSeek V4 Flash: this build uses ONE LLM model everywhere text reasoning is used.
# Never put a real key in a file you share or commit. Use .env.local locally.
DEEPSEEK_ENABLED=true
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Raw sample values are OFF by default. Turn on only for dummy/public or explicitly approved data.
DEEPSEEK_SEND_SAMPLE_VALUES=false
DEEPSEEK_SEND_DOCUMENT_TEXT=false
DEEPSEEK_SEND_STRUCTURED_EVIDENCE=false
DEEPSEEK_QUERY_REWRITE=true
DEEPSEEK_JOIN_REASONING=true
DEEPSEEK_SCHEMA_REASONING=true
DEEPSEEK_TIMEOUT_SECONDS=60

# Security: off | api_key | oidc
AUTH_MODE=off
API_KEYS_JSON={"change-me-admin":"admin","change-me-engineer":"engineer","change-me-viewer":"viewer"}
OIDC_ISSUER=http://localhost:8080/realms/factory
OIDC_AUDIENCE=factory-copilot

# Retrieval: local | qdrant
VECTOR_BACKEND=local
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=factory_docs
REDACT_BEFORE_LLM=true
MAX_FILE_MB=200
